<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_07_bpmn_service_handover" targetNamespace="https://storeassist.example/portfolio/bpmn" exporter="StoreAssist diagram builder">
  <bpmn:process id="Process_07_bpmn_service_handover" name="TO-BE · передача обслуживания продавцу" isExecutable="false">
    <bpmn:documentation>Передаётся всё активное обслуживание. Складской исполнитель и работа склада не меняются.
Новый коллега сам принимает предложение. До сохранённого принятия назначен прежний продавец.
Необходимость отзыва определяется инициатором, а не таймером. Новая попытка — после сохранённого отказа или отзыва.
Принятие и отзыв сохраняются по актуальному состоянию: первое сохранённое решение нельзя отменить устаревшим действием.
Время, история, очередь, зоны и складские исполнители запросов сохраняются. Отсутствие ответа не меняет назначение.
Требования: FR-28, FR-29, FR-30, FR-33, FR-16, RULE-17, RULE-18, RULE-19, RULE-25</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_0" name="Продавец / руководитель">
        <bpmn:flowNodeRef>Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WithdrawAction</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="StoreAssist">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>No</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SaveWithdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Switch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Changed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Actual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Unchanged</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Need" name="Нужна смена продавца">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Choose" name="Выбрать коллегу своего магазина; при затруднении помогает руководитель">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Check" name="Проверить активность, текущего продавца и прежнее предложение">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Allowed" name="Предложение допустимо?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="No" name="Предложение не создано">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Offer" name="Сохранить предложение; показать коллеге актуальный контекст">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Wait" name="Ожидать решение или необходимость отзыва">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Accept" name="Коллега запросил принятие">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="Condition_Accept">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Выбранный коллега отправил команду принятия этого предложения</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Decline" name="Отказ сохранён">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="Condition_Decline">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">По этому предложению сохранён отказ выбранного коллеги</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Withdraw" name="Инициатор решил отозвать предложение">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="Condition_Withdraw">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Инициатор решил отозвать это предложение; автоматического срока отзыва нет</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="WithdrawAction" name="Отозвать ожидающее предложение">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="SaveWithdraw" name="Проверить назначение и состояние; сохранить отзыв, если предложение ожидает">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Withdrawn" name="Отзыв сохранён?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Recheck" name="Проверить актуального владельца, активность и ожидающее предложение">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Принятие допустимо?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Switch" name="Сохранить нового продавца; переключить управление и уведомления">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Changed" name="Обслуживание принято">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Actual" name="Показать актуальное состояние; устаревшее действие не применять">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Unchanged" name="Действие не применено">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Need" targetRef="Choose" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Choose" targetRef="Check" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Check" targetRef="Allowed" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Allowed" targetRef="No" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Allowed" targetRef="Offer" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Offer" targetRef="Wait" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Wait" targetRef="Accept" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Wait" targetRef="Decline" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Wait" targetRef="Withdraw" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Accept" targetRef="Recheck" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Decline" targetRef="Choose" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Withdraw" targetRef="WithdrawAction" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="WithdrawAction" targetRef="SaveWithdraw" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="SaveWithdraw" targetRef="Withdrawn" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Withdrawn" targetRef="Choose" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Withdrawn" targetRef="Actual" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Recheck" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Valid" targetRef="Switch" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Switch" targetRef="Changed" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Valid" targetRef="Actual" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Actual" targetRef="Unchanged" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Store" name="Магазин · StoreAssist" processRef="Process_07_bpmn_service_handover" />
  </bpmn:collaboration>
