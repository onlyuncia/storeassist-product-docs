<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_04_bpmn_cancellation" targetNamespace="https://storeassist.example/portfolio/bpmn" exporter="StoreAssist diagram builder">
  <bpmn:process id="Process_04_bpmn_cancellation" name="TO-BE · отмена и фактическая передача" isExecutable="false">
    <bpmn:documentation>Продавец запрашивает отмену; начатый запрос завершает текущий складской исполнитель.
Если факт не выяснен, запрос активен с ожидающей отменой; часы ожидания и назначение сохраняются.
Руководитель помогает сверить факты, но не завершает запрос вместо исполнителя. Итог сверки и причина отмены остаются в истории.
Перед сохранением проверяются текущий исполнитель и состояние; завершённый исход не переписывается. Неизвестный ответ требует сверки.
Требования: FR-07, FR-09, FR-10, FR-12, FR-16, RULE-08, RULE-09, RULE-27</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_0" name="Текущий продавец">
        <bpmn:flowNodeRef>Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="StoreAssist">
        <bpmn:flowNodeRef>State</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Immediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ImmediateEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinalEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Flag</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Складской исполнитель">
        <bpmn:flowNodeRef>Fact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dispute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Passed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PassedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Stopped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StoppedEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Руководитель смены">
        <bpmn:flowNodeRef>Help</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Wait</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Need" name="Запрос стал неактуален">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Cancel" name="Запросить отмену с обязательной причиной">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="State" name="Текущее состояние?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Immediate" name="Сохранить «Отменён» до принятия складом">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ImmediateEnd" name="Отменён">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Final" name="Показать сохранённый финальный исход">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="FinalEnd" name="Исход не переписан">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Flag" name="Показать складу «Запрошена отмена»">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="Fact" name="Проверить факт передачи и положение вещи">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Dispute" name="Есть спор?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Help" name="Сверить факты с текущим продавцом и исполнителем">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Outcome" name="Что установлено?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Passed" name="Подтвердить передачу на терминале">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="PassedEnd" name="Передан">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Stopped" name="Подтвердить отмену на терминале">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="StoppedEnd" name="Отменён">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="Wait" name="Продолжить сверку; не подтверждать предполагаемый исход">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Need" targetRef="Cancel" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Cancel" targetRef="State" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="State" targetRef="Immediate" name="Создан">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Создан</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Immediate" targetRef="ImmediateEnd" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="State" targetRef="Final" name="Уже финален">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Уже финален</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Final" targetRef="FinalEnd" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="State" targetRef="Flag" name="Начат">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Начат</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Flag" targetRef="Fact" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Fact" targetRef="Dispute" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Dispute" targetRef="Help" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Dispute" targetRef="Outcome" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Help" targetRef="Outcome" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Outcome" targetRef="Passed" name="Уже передан">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Уже передан</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Passed" targetRef="PassedEnd" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Outcome" targetRef="Stopped" name="Не передан;&#10;положение урегулировано">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Не передан;
положение урегулировано</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Stopped" targetRef="StoppedEnd" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Outcome" targetRef="Wait" name="Факт не выяснен">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Факт не выяснен</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Wait" targetRef="Fact" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Store" name="Магазин · StoreAssist" processRef="Process_04_bpmn_cancellation" />
