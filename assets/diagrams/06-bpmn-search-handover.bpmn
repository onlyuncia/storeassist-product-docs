<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_06_bpmn_search_handover" targetNamespace="https://storeassist.example/portfolio/bpmn" exporter="StoreAssist diagram builder">
  <bpmn:process id="Process_06_bpmn_search_handover" name="TO-BE · передача поиска на складе" isExecutable="false">
    <bpmn:documentation>Текущий исполнитель или руководитель вручную выбирает другого складского сотрудника своего магазина.
Разрешено только «В работе», без ожидающей отмены; чужой магазин, неподходящая роль и выбор себя отклоняются.
До сохранённого принятия отвечает прежний исполнитель. При отказе, отзыве или отсутствии ответа автоматического назначения нет.
Повтор после потерянного ответа уточняет тот же результат; исходные времена и проверенные места сохраняются.
Требования: FR-19, FR-20, FR-12, FR-16, RULE-12, RULE-13</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_0" name="Исполнитель / руководитель">
        <bpmn:flowNodeRef>Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choose</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Выбранный коллега склада">
        <bpmn:flowNodeRef>Reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Yes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="StoreAssist">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>No</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Keep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>KeepEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Switch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Need" name="Нужна помощь в поиске">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Choose" name="Вручную выбрать другого коллегу склада своего магазина">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Check" name="Проверить инициатора, получателя, магазин, состояние и отмену">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Allowed" name="Передача допустима?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="No" name="Предложение не создано">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Offer" name="Сохранить предложение; передать историю поиска">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Reply" name="Принять или отклонить предложение">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Yes" name="Коллега принимает?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Keep" name="Показать актуальное назначение; записать отказ / отклонение">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="KeepEnd" name="Действие не применено">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Recheck" name="При принятии повторно проверить состояние, отмену и назначение">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Условия ещё выполняются?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Switch" name="Сохранить одного нового исполнителя и историю">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Коллега продолжает поиск">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Need" targetRef="Choose" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Choose" targetRef="Check" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Check" targetRef="Allowed" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Allowed" targetRef="No" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Allowed" targetRef="Offer" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Offer" targetRef="Reply" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Reply" targetRef="Yes" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Yes" targetRef="Keep" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Keep" targetRef="KeepEnd" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Yes" targetRef="Recheck" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Recheck" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Valid" targetRef="Switch" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Valid" targetRef="Keep" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Switch" targetRef="Done" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Store" name="Магазин · StoreAssist" processRef="Process_06_bpmn_search_handover" />
  </bpmn:collaboration>
