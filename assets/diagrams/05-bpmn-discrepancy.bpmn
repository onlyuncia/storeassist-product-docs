<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_05_bpmn_discrepancy" targetNamespace="https://storeassist.example/portfolio/bpmn" exporter="StoreAssist diagram builder">
  <bpmn:process id="Process_05_bpmn_discrepancy" name="TO-BE · проверка наличия и размещения" isExecutable="false">
    <bpmn:documentation>Отдельное обращение. Его жизненный цикл не завершает и не открывает запрос выдачи.
Открытое обращение по тому же магазину и варианту дополняется эпизодом; прежний ответственный и время создания сохраняются.
Старший закрывает только завершённую проверку с результатом. Его роль не предоставляет права менять учёт.
После проверки размещения и при открытии карточки адрес читается заново. Сбой: последнее значение с предупреждением; наблюдение отдельно.
Требования: FR-21, FR-22, FR-23, FR-24, FR-34, RULE-14, RULE-15, RULE-24, RULE-28</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_0" name="Сотрудник склада">
        <bpmn:flowNodeRef>Issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="StoreAssist">
        <bpmn:flowNodeRef>Existing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Append</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Appended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>New</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Refresh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Старший склада">
        <bpmn:flowNodeRef>Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Close</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Уполномоченный по учёту">
        <bpmn:flowNodeRef>Accounting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Issue" name="Не найдено / другое место хранения">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Report" name="Сообщить проблему своего магазина и варианта">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Existing" name="Есть открытое обращение?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Append" name="Добавить эпизод; сохранить ответственного">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Appended" name="Проверка продолжается в существующем обращении">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="New" name="Создать обращение; показать старшему склада">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Accept" name="Принять обращение; сохранить ответственного старшего и время">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Review" name="Провести или организовать проверку до результата">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Fix" name="Нужно исправление?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Accounting" name="Исправить данные в действующей системе">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Close" name="Сохранить итог и сведения об операции, если была; закрыть проверку">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Refresh" name="Если проверялось размещение: заново прочитать адрес из источника по FR-34">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Проверка закрыта">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Issue" targetRef="Report" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Report" targetRef="Existing" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Existing" targetRef="Append" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Append" targetRef="Appended" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Existing" targetRef="New" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="New" targetRef="Accept" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Accept" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Review" targetRef="Fix" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Fix" targetRef="Accounting" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Fix" targetRef="Close" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Accounting" targetRef="Close" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Close" targetRef="Refresh" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Refresh" targetRef="Done" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Store" name="Магазин · StoreAssist" processRef="Process_05_bpmn_discrepancy" />
  </bpmn:collaboration>
