        <di:waypoint x="1492.5" y="703.5" />
        <di:waypoint x="1492.5" y="809.75" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1796.5" y="678.25" width="38" height="26" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_8" bpmnElement="Flow_8">
        <di:waypoint x="1630.0" y="861.0" />
        <di:waypoint x="1665.0" y="861.0" />
        <di:waypoint x="1665.0" y="954.75" />
