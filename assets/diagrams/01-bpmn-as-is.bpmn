        <di:waypoint x="2252.5" y="362.75" />
        <di:waypoint x="2086.25" y="362.75" />
        <di:waypoint x="2086.25" y="327.75" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_10" bpmnElement="Flow_10">
        <di:waypoint x="2086.25" y="225.25" />
        <di:waypoint x="2086.25" y="190.25" />
        <di:waypoint x="2376.25" y="190.25" />
        <di:waypoint x="2376.25" y="255.25" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>