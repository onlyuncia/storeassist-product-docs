<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_02_bpmn_to_be" targetNamespace="https://storeassist.example/portfolio/bpmn" exporter="StoreAssist diagram builder">
  <bpmn:process id="Process_02_bpmn_to_be" name="TO-BE · от запроса до выдачи" isExecutable="false">
    <bpmn:documentation>Основной сценарий. Правила создания раскрыты на схеме 03; отмена — на схеме 04.
«Не найдено» завершает этот запрос. Альтернатива создаёт отдельный связанный запрос в том же обслуживании.
Обращение о расхождении выполняется независимо (схема 05); передачи работы — схемы 06–07.
С 5 минут активный запрос только выделяется; время создания не сбрасывается. Это настройка пилота, не SLA.
Требования: FR-02, FR-04, FR-06, FR-07, FR-08, FR-13, FR-25, FR-26, FR-31, FR-32</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_0" name="Продавец · iPod">
        <bpmn:flowNodeRef>Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Alternatives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AgreeWithBuyer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Agreed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NoAlternative</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>New</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NewEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="StoreAssist">
        <bpmn:flowNodeRef>Created</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotCreated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Number</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Сотрудник склада">
        <bpmn:flowNodeRef>Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecordPlaces</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Passed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotFound</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Need" name="Нужен вариант товара">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Prepare" name="Выбрать вариант и зону; выполнить отправку по схеме 03">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Created" name="Запрос создан?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="NotCreated" name="Запрос не создан">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Number" name="Показать номер, «Создан» и время">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Accept" name="Принять запрос; «В работе»">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Search" name="Искать нужный вариант">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="RecordPlaces" name="Отметить проверенные места в карточке">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Found" name="Вещь найдена?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Ready" name="Отметить «Готов к передаче»">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Deliver" name="Вынести в выбранную зону; передать текущему продавцу">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Confirm" name="Подтвердить передачу на терминале">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Passed" name="Передан">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="NotFound" name="Сохранить «Не найдено»; комментарий необязателен">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Notify" name="Показать исход и уведомление в iPod">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Alternatives" name="Открыть варианты модели и связи каталога">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="AgreeWithBuyer" name="Согласовать вариант с покупателем">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Agreed" name="Вариант выбран и согласован?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="NoAlternative" name="Новый запрос не создан">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="New" name="Отправить отдельный связанный запрос по схеме 03">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="NewEnd" name="Новая попытка по отдельному запросу">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Need" targetRef="Prepare" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Prepare" targetRef="Created" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Created" targetRef="NotCreated" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Created" targetRef="Number" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Number" targetRef="Accept" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Accept" targetRef="Search" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Search" targetRef="RecordPlaces" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="RecordPlaces" targetRef="Found" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Found" targetRef="Ready" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Ready" targetRef="Deliver" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Deliver" targetRef="Confirm" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Confirm" targetRef="Passed" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Found" targetRef="NotFound" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="NotFound" targetRef="Notify" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Notify" targetRef="Alternatives" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Alternatives" targetRef="AgreeWithBuyer" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="AgreeWithBuyer" targetRef="Agreed" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Agreed" targetRef="New" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="New" targetRef="NewEnd" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Agreed" targetRef="NoAlternative" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
