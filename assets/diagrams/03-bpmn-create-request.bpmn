<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_03_bpmn_create_request" targetNamespace="https://storeassist.example/portfolio/bpmn" exporter="StoreAssist diagram builder">
  <bpmn:process id="Process_03_bpmn_create_request" name="TO-BE · проверка наличия и создание запроса" isExecutable="false">
    <bpmn:documentation>Одинаковое правило для обычного запроса и согласованной альтернативы.
Подтверждение предупреждения относится к выбранному варианту и текущей попытке; повторного чтения по кругу нет.
Для альтернативы предварительно нужны выбор продавца и согласие покупателя; оно не заменяет подтверждение неизвестного наличия.
Потеря ответа StoreAssist: уточнить сохранённый результат, повторить то же действие без дубля. Принятие не является резервом.
Требования: FR-01, FR-02, FR-11, FR-16, FR-18, FR-26, FR-31, FR-32</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_0" name="StoreAssist">
        <bpmn:flowNodeRef>Read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Value</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Zero</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Warning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Текущий продавец">
        <bpmn:flowNodeRef>Intent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Consent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>No</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Intent" name="Новая отправка">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Choose" name="Выбрать точный вариант и зону; учесть прошлый поиск, если он был">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Read" name="Получить текущий остаток своего магазина и варианта">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Value" name="Результат обновления?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Zero" name="Актуальный ноль: запрос запрещён">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Warning" name="Показать предупреждение: наличие не подтверждено">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Confirm" name="Явно подтвердить отправку после предупреждения">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Consent" name="Подтверждено?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="No" name="Запрос не создан">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge" name="Отправка разрешена">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Create" name="Создать запрос: номер, время, вариант и обслуживание">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Запрос создан">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Intent" targetRef="Choose" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Choose" targetRef="Read" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Read" targetRef="Value" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Value" targetRef="Zero" name="Ноль">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ноль</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Value" targetRef="Warning" name="Нет актуальных данных">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет актуальных данных</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Warning" targetRef="Confirm" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Confirm" targetRef="Consent" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Consent" targetRef="No" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Consent" targetRef="Merge" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Value" targetRef="Merge" name="Положительный остаток">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Положительный остаток</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Merge" targetRef="Create" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Create" targetRef="Done" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Store" name="Магазин · StoreAssist" processRef="Process_03_bpmn_create_request" />
  </bpmn:collaboration>
